{
  "이름": "한국어",
  "확장자": "txt",
  "산문": true,
  "형": {
    "정수": "정수",
    "정수열": "정수열"
  },
  "들여쓰기": "    ",
  "겉": "{함수들}\n",
  "함수": "{이름}{~은} {입력}{~을} 받아 {반환형}{~을} 내놓는다.\n{몸}",
  "입력항": "{이름}({형})",
  "입력사이": "와 ",
  "인자사이": "와 ",
  "선언": "{이름}{~을} {식}{~으로} 둔다.",
  "대입": "{이름}{~을} {식}{~으로} 바꾼다.",
  "색인대입": "{열}의 {자리}번째{~을} {식}{~으로} 바꾼다.",
  "반복": "{조건} 동안 되풀이한다:\n{몸}",
  "분기": "{조건}면:\n{몸}",
  "분기아니면": "{조건}면:\n{몸}\n아니면:\n{아니면}",
  "반환": "{식}{~을} 내놓는다.",
  "시험줄": "{호출}",
  "열시험줄": "{호출}",
  "호출": "{이름}에 {인자}{~을} 준 값",
  "호출식": "({이름}에 {인자}{~을} 준 값)",
  "열": "[{항목}]",
  "식": {
    "이름": "{0}",
    "수": "{0}",
    "길이": "({0}의 길이)",
    "색인": "({0}의 {1}번째)",
    "더하기": "({0} 더하기 {1})",
    "빼기": "({0} 빼기 {1})",
    "몫": "({0}{~을} {1}{~으로} 나눈 몫)",
    "나머지": "({0}{~을} {1}{~으로} 나눈 나머지)",
    "==": "({0}{~이} {1}{~와} 같으)",
    "<": "({0}{~이} {1}보다 작으)",
    "<=": "({0}{~이} {1}보다 작거나 같으)",
    ">": "({0}{~이} {1}보다 크)",
    "곱하기": "({0} 곱하기 {1})"
  }
}
