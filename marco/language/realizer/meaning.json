  "sources_complete": {"roles": {}},
  "chain_statement": {"_about": "Why, from the trace graph (goal W4): a statement the answer rests on, recorded at a turn; the user's words quoted.", "roles": {"turn": "numeral", "said": "quote"}, "numbers": ["turn"]},
  "chain_asked": {"_about": "The question an answer answered, at its turn, quoted.", "roles": {"turn": "numeral", "said": "quote"}, "numbers": ["turn"]},
  "count_change": {"_about": "A recorded change of a count, from one value to another.", "roles": {"subject": "compound", "before": "numeral", "after": "numeral"}, "numbers": ["before", "after"]},
  "reading_corrected": {"_about": "A correction at turn `by`, quoted, replaced the reading of the statement at turn `turn`: the old reading is withdrawn and superseded.", "roles": {"turn": "numeral", "by": "numeral", "said": "quote"}, "numbers": ["turn", "by"]},
  "change_withdrawn": {"_about": "A change the answer no longer rests on: withdrawn after a correction, superseded by a change said before it. Without a value before, the earlier value is withdrawn.", "roles": {"subject": "compound", "before": "numeral", "after": "numeral"}, "numbers": ["before", "after"]},
  "chain_held": {"_about": "A held reply: the turn whose answer was held, its words quoted.", "roles": {"turn": "numeral", "said": "quote"}, "numbers": ["turn"]},
  "chain_unread": {"_about": "The hold waits on a statement not read, at its turn, quoted.", "roles": {"turn": "numeral", "said": "quote"}, "numbers": ["turn"]},
  "chain_which": {"_about": "The hold's pointer could name any of the holders listed.", "roles": {"word": "quote", "candidates": "owners"}},
  "chain_which_event": {"_about": "A correction could point to more than one earlier event.", "roles": {}},
  "chain_value_place": {"_about": "A correction's old value had no single place in the event it names.", "roles": {}},
  "chain_replied": {"_about": "A hold whose reason no declared frame says: the reply as it was said, quoted, at its turn.", "roles": {"turn": "numeral", "said": "quote"}, "numbers": ["turn"]}
 },
 "relations": {
  "_about": "Triple predicate -> frame, and where the triple's subject and object go. A subject listed as several roles is the engine's compound subject (owner words, then item words).",
  "count": {"frame": "count", "subject": ["owner", "item"], "object": "value"},
  "location": {"frame": "location", "subject": ["theme"], "object": "place"}
 },
 "quantity_effects": {
  "_about": "State changes that together are one transfer: the side that loses and the side that gains the same amount in one event.",
  "frame": "transfer",
  "loses": "giver",
  "gains": "receiver",
  "amount": "amount",
  "item": "item"
 },
 "holders": {
  "_about": "Holders that are not bare names (round 4; the meaning block field is the one request docs/requests/W3-1.md asks goal G4 for). The meaning block may carry holders: {key: {kind, said}} for the holder keys its triples, changes and fields use. speaker: the user, said as the one addressed, in the person forms the language file declares (each form the user says of themself one of its pack's first-person forms). place: a place that holds things, said with the language's place expressions. named: a holder the user named with more words than its key (a title, a relation, an apposition), said as the user named it, the user's own first-person words turned to the one addressed. A holder whose key is the conversation language's first-person holder word (its pack's 임자자리말) is the speaker without the field. A holder key of several words is the owner of a compound subject that begins with it. In the reading the semantic check parses, every holder is said as the user would say it (the speaker in the first person), so the pack reads its key back; any other saying of it is never checked against the key.",
  "field": "holders",
  "kinds": ["speaker", "place", "named"],
  "speaker": "speaker",
  "place": "place",
  "named": "named",
  "name": "name"
 },
 "zero_count": {
  "_about": "A count of zero (round 4: 'has no X at all', 'none left') is said as having none of the thing, when the language says that in words its pack reads back as the count zero; otherwise the count itself is said, its zero in digits. Nothing is held for it.",
  "frame": "count",
  "value": "value",
  "zero": "0",
  "said_as": "count_none"
 },
 "time_orders": ["before", "after"],
 "time_event": {
  "_about": "The event an answer about an earlier time is relative to: the one transfer its recorded changes make, composed; any other event (one side only, a move, several transfers) is the user's own statement of it, quoted in this frame. The event's amount is not said: it names which event, and the reply states one quantity, the answer's.",
  "quoted_frame": "event_said",
  "elide": ["amount"]
 },
 "turn_plans": [
  {
   "_about": "Several questions in one turn (Diairesis; goal G5.6, request W5-1; assumed meaning: act inform, kind queries, answers = one meaning block per question in the order asked, each with its own status and, for an answered triple, fact and evidence): each answer said by the plan it would have alone, in order, each naming whose it is; consecutive answers in one sentence. A turn with an answer no plan says is not said in part: the declared hold is said instead. shared: the turn's fields every answer keeps; answer_row: an answer's fields that make its answered fact's row, the triple first.",
   "match": {"act": "inform", "kind": "queries"},
   "each": "$answers",
   "shared": ["holders", "conversation", "conversation_language"],
   "answer_row": ["fact", "evidence"],
   "acts": [{"intent": "REFUSE", "fallback": true, "props": [{"frame": "not_phrased"}]}]
  },
  {
   "_about": "An answered question about the state just before or just after one earlier event (request G3-4): the answer said in the past, with the event it is relative to as a time clause.",
   "match": {
    "status": "answered",
    "source": "fact",
    "act": [null, "inform"],
    "fields_has": "time",
    "checks_exclude": ["explained_recorded_transitions"]
   },
   "acts": [{"intent": "INFORM", "props": [{"from": "fact", "focus": "object", "time": "$time"}]}]
  },
  {
   "_about": "An answered question: the answer fact, its asked value as focus. A result the engine marks as an explanation carries facts too; it is not an answer.",
   "match": {
    "status": "answered",
    "source": "fact",
    "act": [null, "inform"],
    "checks_exclude": ["explained_recorded_transitions"]
   },
   "acts": [{"intent": "INFORM", "props": [{"from": "fact", "focus": "object"}]}]
  },
  {
   "_about": "3b of §12: the subject is known, the relation was never stated.",
   "match": {"act": "refuse", "reason": "premise_missing"},
   "acts": [
    {
     "intent": "REFUSE",
     "props": [
      {"frame": "known", "roles": {"subject": "$subject", "relation": "$relation"}, "polarity": false},
      {"frame": "answered", "polarity": false, "tense": "past"}
     ]
    }
   ]
  },
  {
   "_about": "6 of §12, the pointer fixes no referent: name the candidates, choose none.",
   "match": {"act": "ask", "reason": "which_referent"},
   "acts": [
    {
     "intent": "ASK",
     "props": [
      {"frame": "reference", "roles": {"word": "$word"}, "polarity": false},
      {"frame": "choice", "roles": {"candidates": "$candidates"}, "sentence": "question"}
     ]
    }
   ]
  },
  {
   "match": {"act": "ask", "reason": "no_referent"},
   "acts": [
    {
     "intent": "REFUSE",
     "props": [{"frame": "referent_found", "roles": {"word": "$word"}, "polarity": false, "tense": "past"}]
    }
   ],
   "_about": "A pointer with nothing in the conversation to point at: say that nothing was found."
  },
  {
   "_about": "6 of §12 when the context leaves exactly one other: say it, ask to confirm, do not assume.",
   "match": {"act": "ask", "reason": "other_than_confirm"},
   "acts": [
    {
     "intent": "ASK",
     "props": [
      {"frame": "other_than", "roles": {"word": "$word", "excluded": "$excluded", "other": "$other"}},
      {"frame": "confirm", "roles": {"other": "$other"}, "sentence": "request"}
     ]
    },
    {
     "intent": "REASSURE",
     "props": [{"frame": "assumed", "roles": {"other": "$other"}, "polarity": false, "tense": "past"}]
    }
   ]
  },
  {
   "_about": "4 of §12: the same event corrected in place.",
   "match": {"act": "correct"},
   "acts": [
    {
     "intent": "CORRECT",
     "props": [{"frame": "corrected", "roles": {"event": "$event", "old": "$old", "new": "$new"}, "tense": "past"}]
    },
    {"intent": "REASSURE", "props": [{"frame": "new_event", "polarity": false, "tense": "past"}]},
    {"intent": "INFORM", "lead": "now", "props": [{"from": "changes", "state": "after"}]}
   ]
  },
  {
   "_about": "5 of §12: why, after a correction. Conclusion first, then the correction, the rules and the statements used.",
   "match": {"act": "explain", "kind": "correction"},
   "acts": [
    {"intent": "INFORM", "conclusion": true, "lead": "now", "props": [{"from": "changes", "state": "after"}]},
    {"intent": "INFORM", "props": [{"frame": "cause", "roles": {"utterance": "$correction.utterance"}}]},
    {
     "intent": "CORRECT",
     "props": [
      {
       "frame": "corrected",
       "roles": {"event": "$correction.before", "old": "$correction.old", "new": "$correction.new"},
       "tense": "past"
      }
     ]
    },
    {"intent": "REASSURE", "props": [{"frame": "new_event", "polarity": false, "tense": "past"}]},
    {"intent": "INFORM", "props": [{"each": "$rules", "frame": "rule", "role": "rule"}]},
    {"intent": "INFORM", "props": [{"frame": "evidence", "roles": {"statements": "$evidence"}}]},
    {"intent": "INFORM", "props": [{"frame": "repairs", "roles": {"pairs": "$repairs"}, "optional": true}]}
   ]
  },
  {
   "_about": "Why, after an answer: the answer again, then the rules and the statements used.",
   "match": {"act": "explain", "kind": "answer"},
   "acts": [
    {"intent": "INFORM", "conclusion": true, "props": [{"from": "changes", "state": "after"}]},
    {"intent": "INFORM", "props": [{"each": "$rules", "frame": "rule", "role": "rule"}]},
    {"intent": "INFORM", "props": [{"frame": "evidence", "roles": {"statements": "$evidence"}}]},
    {"intent": "INFORM", "props": [{"frame": "repairs", "roles": {"pairs": "$repairs"}, "optional": true}]}
   ]
  },
  {
   "_about": "Why, from the trace graph's why chain (goal W4, request L1-2; marco/trace/explain.py builds the meaning): in order, what was recorded, what changed and by which rule, what a correction withdrew, and what was concluded. Rows are the chain's own events in ledger order; a row a case does not cover is not said.",
   "match": {"act": "explain", "kind": "chain"},
   "acts": [
    {"intent": "INFORM", "props": [{"rows": "$statements", "cases": [
     {"frame": "chain_statement", "roles": {"turn": "@turn", "said": "@said"}, "requires": ["turn", "said"], "tense": "past"}]}]},
    {"intent": "INFORM", "props": [{"rows": "$changes", "cases": [
     {"where": {"whole": true, "field": "count", "before": null}, "fact": ["@subject", "@field", "@after"],
      "tense": "past"},
     {"where": {"whole": true, "field": "count"}, "frame": "count_change",
      "roles": {"subject": "@subject", "before": "@before", "after": "@after"}, "requires": ["subject", "before", "after"],
      "tense": "past"},
     {"where": {"whole": true}, "fact": ["@subject", "@field", "@after"], "tense": "past", "optional": true}]}]},
    {"intent": "INFORM", "props": [{"each": "$rules", "frame": "rule", "role": "rule", "optional": true}]},
    {"intent": "CORRECT", "props": [
     {"rows": "$corrections", "cases": [
      {"frame": "reading_corrected", "roles": {"turn": "@turn", "by": "@by", "said": "@said"},
       "requires": ["turn", "by", "said"], "tense": "past"}]},
     {"rows": "$withdrawn", "cases": [
      {"where": {"what": "change", "whole": true}, "frame": "change_withdrawn",
       "roles": {"subject": "@subject", "before": "@before", "after": "@after"}, "requires": ["subject", "after"],
       "tense": "past"}]}]},
    {"intent": "INFORM", "props": [{"frame": "chain_asked", "roles": {"turn": "$asked.turn", "said": "$asked.said"},
                                    "tense": "past", "optional": true}]},
    {"intent": "INFORM", "lead": "so", "props": [{"rows": "$facts", "cases": [
     {"fact": ["@subject", "@relation", "@value"]}]}]}
   ]
  },
  {
   "_about": "Why a reply was held, from the trace graph's why chain (goal W4, request L1-2 item 2): what the chain recorded, changed and withdrew, if anything; the turn whose answer was held; then the hold's reason in the frames chain.hold_reasons declares for it, with what was missing.",
   "match": {"act": "explain", "kind": "chain_hold"},
   "acts": [
    {"intent": "INFORM", "props": [{"rows": "$statements", "cases": [
     {"frame": "chain_statement", "roles": {"turn": "@turn", "said": "@said"}, "requires": ["turn", "said"], "tense": "past"}]}]},
    {"intent": "INFORM", "props": [{"rows": "$changes", "cases": [
     {"where": {"whole": true, "field": "count", "before": null}, "fact": ["@subject", "@field", "@after"],
      "tense": "past"},
     {"where": {"whole": true, "field": "count"}, "frame": "count_change",
      "roles": {"subject": "@subject", "before": "@before", "after": "@after"}, "requires": ["subject", "before", "after"],
      "tense": "past"},
     {"where": {"whole": true}, "fact": ["@subject", "@field", "@after"], "tense": "past", "optional": true}]}]},
    {"intent": "CORRECT", "props": [
     {"rows": "$corrections", "cases": [
      {"frame": "reading_corrected", "roles": {"turn": "@turn", "by": "@by", "said": "@said"},
       "requires": ["turn", "by", "said"], "tense": "past"}]},
     {"rows": "$withdrawn", "cases": [
      {"where": {"what": "change", "whole": true}, "frame": "change_withdrawn",
       "roles": {"subject": "@subject", "before": "@before", "after": "@after"}, "requires": ["subject", "after"],
       "tense": "past"}]}]},
    {"intent": "REFUSE", "props": [{"frame": "chain_held", "roles": {"turn": "$held.turn", "said": "$held.said"},
                                    "tense": "past"}]},
    {"intent": "REFUSE", "props": [{"from": "hold_reason"}]}
   ]
  },
  {
   "_about": "A statement recorded: acknowledge, then only what the listener does not already know.",
   "match": {"act": "record", "reason": "observed_state"},
   "acts": [
    {"intent": "INFORM", "props": [{"frame": "recorded", "tense": "past"}]},
    {"intent": "INFORM", "props": [{"from": "transfers", "new_only": true}]},
    {"intent": "INFORM", "lead": "now", "props": [{"from": "changes", "state": "after", "new_only": true}]}
   ]
  },
  {
   "_about": "The new statement cannot hold together with the recorded state: warn, ask to check.",
   "match": {"act": "hold", "reason": "invalid"},
   "acts": [
    {"intent": "WARN", "props": [{"frame": "conflict", "polarity": false}]},
    {"intent": "ASK", "props": [{"frame": "check_request", "sentence": "request"}]}
   ]
  },
  {
   "_about": "As stated, the amounts do not add up: warn with the statement, ask which part to correct.",
   "match": {"act": "hold", "reason": "contradiction"},
   "acts": [
    {"intent": "WARN", "props": [{"frame": "sum_mismatch", "roles": {"said": "$said"}, "polarity": false}]},
    {"intent": "ASK", "props": [{"frame": "check_request", "sentence": "request"}]}
   ]
  },
  {
   "_about": "An earlier statement is still unread: the current value is not fixed.",
   "match": {"act": "hold", "reason": "unread_event"},
   "acts": [
    {
     "intent": "REFUSE",
     "props": [
      {"frame": "unread", "roles": {"said": "$said"}, "polarity": false, "tense": "past"},
      {"frame": "value_fixed", "polarity": false, "tense": "past"}
     ]
    },
    {"intent": "ASK", "props": [{"frame": "rephrase", "sentence": "request"}]}
   ]
  },
  {
   "_about": "A correction names no earlier event: nothing is corrected.",
   "match": {"act": "hold", "reason": "reference_no_event"},
   "acts": [
    {
     "intent": "REFUSE",
     "props": [
      {"frame": "no_event", "roles": {"said": "$said"}, "polarity": false, "tense": "past"},
      {"frame": "nothing_corrected", "polarity": false, "tense": "past"}
     ]
    }
   ]
  },
