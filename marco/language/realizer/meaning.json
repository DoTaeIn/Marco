 "repair_notes": {
  "_about": "A reading that rested on a repair. The spoken reply says at most one short clause of what was read, first, and only when the reading skipped or reordered a word; a reading that only moved, dropped or added a particle or restored an ending changed no meaning and is not said. Every note is kept in full in the trace, and said in full when asked what was changed.",
  "intent": "INFORM",
  "frame": "repair_note",
  "position": "first",
  "spoken_at_most": 1,
  "silent_operations": ["particle_drop", "particle_insert", "particle_move", "ending_restore"],
  "full_frame": "repair_note_full"
 },
 "discourse": {
  "_about": "What to say and what to leave out. Each rule is data the planner executes.",
  "answer_ellipsis": {
   "_about": "In an answer the question already named everything but the focus. A holder role is left out only when the question itself named that holder (not through a pointer, not by leaving it out); otherwise the answer names whose it is.",
   "intents": ["INFORM"],
   "elide": "given_non_focus",
   "holder_roles": ["owner"]
  },
  "repeat_ellipsis": {
   "_about": "Inside one utterance, a role repeated from the previous clause of the same frame is not said again; except in a clause whose holder is the user, who a language may leave unsaid: the repeated role then tells whose count it is.",
   "frames": ["count"],
   "roles": ["item"],
   "not_for_holders": ["speaker"]
  },
  "known_facts": {
   "_about": "A fact the user stated in this turn is not repeated, unless its reading added something not typed (inherited by ellipsis, read through a repair).",
   "keep_when": ["ellipsis", "repaired", "resolved"]
  },
  "conclusion_first": true,
  "lead_needs_change": {
   "_about": "A lead word that marks a changed state is said only when the act says a value that changed.",
   "on": true
  },
  "reasons": {
   "_about": "Reasons are given only when asked or when a correction changed a value.",
   "when_acts": ["explain", "correct"]
  },
  "coordinate": {
   "_about": "Consecutive clauses of one frame in one act are joined into one sentence.",
   "frames": ["count"]
  }
 },
 "chain": {
  "_about": "Why said from the trace graph (goal W4, request L1-2). A plan template {rows: $field, cases: [...]} says one proposition per row of a list field: the first case whose `where` the row matches (a null value matches a missing one), its `fact` (a triple of row values, said as the relation's frame) or its `frame` with `roles`; `row_mark` names a row's own field. A row without a value a case `requires` is not said; a case marked optional is left out when the language cannot say it in words its pack reads back (a state other than a count, in the past). {from: hold_reason} says the reason of a held reply in the templates hold_reasons lists under the reason's id, with the fields the chain gives: missing (as the hold event recorded it), statement (the input the hold names, resolved to its turn and words), reply (what was said then). A reason without an entry, or whose entry says nothing, takes _default.",
  "row_mark": "@",
  "hold_reasons": {
   "unread_event": [{"frame": "chain_unread", "roles": {"turn": "$statement.turn", "said": "$statement.said"}, "polarity": false,
                     "tense": "past", "optional": true}],
   "which_referent": [{"frame": "chain_which", "roles": {"word": "$missing.word", "candidates": "$missing.candidates"},
                       "polarity": false, "tense": "past", "optional": true}],
   "no_referent": [{"frame": "referent_found", "roles": {"word": "$missing.word"}, "polarity": false, "tense": "past",
                    "optional": true}],
   "input_understanding_failed": [{"frame": "topic_found", "polarity": false, "tense": "past"}],
   "not_stated": [{"frame": "heard", "roles": {"subject": "$missing.subject"}, "polarity": false, "optional": true}],
   "premise_missing": [{"frame": "known", "roles": {"subject": "$missing.subject", "relation": "$missing.relation"},
                        "polarity": false, "optional": true}],
   "unknown_word": [{"frame": "word_known", "roles": {"word": "$missing.word"}, "polarity": false, "optional": true}],
   "reference_which_event": [{"frame": "chain_which_event", "polarity": false, "tense": "past"}],
   "reference_value_unclear": [{"frame": "chain_value_place", "polarity": false, "tense": "past"}],
   "unresolved": [{"frame": "decided", "polarity": false}],
   "contradiction": [{"frame": "sum_mismatch", "roles": {"said": "$statement.said"}, "polarity": false, "optional": true}],
   "invalid": [{"frame": "conflict", "polarity": false}],
   "vague_count": [{"frame": "count_unknown", "split": "$missing.subject", "polarity": false}],
   "explain_nothing": [{"frame": "explainable", "polarity": false}],
   "capacity": [{"frame": "limit_reached", "tense": "past"}],
   "_default": [{"frame": "chain_replied", "roles": {"turn": "$reply.turn", "said": "$reply.said"}, "tense": "past",
                 "optional": true}]
  }
 },
 "hold": {
  "_about": "Said when no candidate expression keeps the meaning. It carries no content that could be wrong.",
  "frames": ["not_phrased"]
 },
 "field_path_separator": ".",
 "variable_marks": ["?", "$"],
 "total_slot": "?n",
 "compound_subject": {
  "_about": "The engine joins a compound subject's words with this separator (owner words, then item words).",
  "separator": " "
 },
 "quoted_fields": {
  "_about": "Role-value fields whose strings may appear quoted in a sentence.",
  "fields": ["quote", "source", "reading", "word", "particle", "to", "rule"]
 }
