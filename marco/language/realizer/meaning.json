  "several_events": {"roles": {"said": "quote", "items": "quotes"}},
  "chosen": {"roles": {}},
  "value_place": {"roles": {"event": "quote", "old": "numeral"}, "numbers": ["old"]},
  "applied": {"roles": {"said": "quote"}},
  "protected_change": {"roles": {"words": "quotes"}},
  "revised": {"roles": {"before": "quote", "after": "quote"}},
  "recipient_corrected": {"_about": "The receiver of one earlier event corrected in place (request G4-1): the event as the user said it, the holder that received before and the one that receives now.", "roles": {"event": "quote", "old": "agent", "new": "agent"}},
  "topic_found": {"roles": {}},
  "plainer_request": {"roles": {}},
  "more_request": {"roles": {}},
  "topic_covered": {"roles": {}},
  "topic_sure": {"roles": {}},
