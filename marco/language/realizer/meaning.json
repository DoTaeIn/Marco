  "more": {"roles": {"winner": "agent", "item": "thing"}},
  "fewer": {"_about": "Of two holders, the one that holds fewer of a thing.", "roles": {"winner": "agent", "item": "thing"}},
  "same_count": {
   "_about": "Two or more holders hold the same number of a thing; the number is said when it is the same. Negative: they do not hold the same number.",
   "roles": {"members": "names", "item": "thing", "value": "numeral"},
   "numbers": ["value"]
  },
  "event_said": {"_about": "An earlier event named by the user's own statement of it, quoted.", "roles": {"said": "quote"}},
  "count_unknown": {
   "_about": "A holder has some of a thing; how many was never said (a vague count). Negative: the number is not known.",
   "roles": {"owner": "agent", "item": "thing"}
  },
  "count_none": {
   "_about": "A holder has none of a thing: a count of zero said as the negation of having any (meaning.json: zero_count). Its reading is the count fact with the value zero.",
   "roles": {"owner": "agent", "item": "thing"}
  },
