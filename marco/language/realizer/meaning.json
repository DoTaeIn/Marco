   "cited": ["cost", "bound"]
  },
  "sum_mismatch": {"roles": {"said": "quote"}},
  "referent_found": {"roles": {"word": "quote"}},
  "repair_note_full": {
   "_about": "The whole note of a reading that rested on a repair: rule, operations, cost. Kept in the trace and said when asked what was changed.",
   "roles": {
    "source": "quote",
    "reading": "quote",
    "rule": "quote",
    "operations": "operations",
    "cost": "numeral",
    "bound": "numeral"
   },
