{
  "이름": "PowerShell",
  "확장자": "ps1",
  "실행": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{파일}"],
  "형": {"정수": "int", "정수열": "array"},
  "들여쓰기": "    ",
  "겉": "{함수들}\n\n{시험}\n",
  "함수": "function {이름}({입력}) {\n{몸}\n}",
  "입력항": "${이름}",
  "입력사이": ", ",
  "인자사이": " ",
  "선언": "${이름} = {식}",
  "대입": "${이름} = {식}",
  "색인대입": "{열}[{자리}] = {식}",
  "반복": "while ({조건}) {\n{몸}\n}",
  "분기": "if ({조건}) {\n{몸}\n}",
  "분기아니면": "if ({조건}) {\n{몸}\n} else {\n{아니면}\n}",
  "반환": "return {식}",
  "시험줄": "Write-Output ({호출})",
  "열시험줄": "Write-Output (({호출}) -join ', ')",
  "호출": "{이름} {인자}",
  "호출식": "({이름} {인자})",
  "열": "@({항목})",
  "식": {
    "이름": "${0}", "수": "{0}", "길이": "{0}.Length", "색인": "{0}[{1}]",
    "더하기": "({0} + {1})", "빼기": "({0} - {1})",
    "몫": "([int][Math]::Floor(({0}) / {1}))",
    "나머지": "({0} % {1})",
    "==": "{0} -eq {1}", "<": "{0} -lt {1}", "<=": "{0} -le {1}",
    ">": "{0} -gt {1}"
  }
}
