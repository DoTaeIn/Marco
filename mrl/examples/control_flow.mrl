# v2 control-flow subset: range is half-open #
fn sum_small(n: si) -> si {
    total = 0
    for (i in 0..n) {
        if (i < 3) {
            total := total + i
        } else {
            total := total + 1
        }
    }
    return total
}

fn main() -> si {
    value = sum_small(5)
    while (value < 10) {
        value := value + 1
    }
    if (value == 10) {
        return value
    } else {
        return 0
    }
}
