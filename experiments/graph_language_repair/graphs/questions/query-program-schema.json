{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded native query graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "alternatives"
  ],
  "properties": {
    "version": {
      "const": "query-graph-v1"
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/alternative"
      }
    }
  },
  "$defs": {
    "triple": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "head",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {},
        "head": {
          "$ref": "#/$defs/triple"
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/triple"
          }
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patterns",
        "project"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/triple"
          }
        },
        "project": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\?.+"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "scope": {
          "const": "reading"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "unresolved": {
          "type": "array"
        },
        "type_status": {
          "enum": [
            "known",
            "unknown"
          ]
        }
      }
    }
  }
}
