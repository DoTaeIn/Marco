{
  "이름": "binary_search",
  "설명": "정렬된 배열에서 가운데를 보고 반씩 줄여 나간다. 없으면 -1.",
  "입력": [["a", "정수열"], ["target", "정수"]],
  "반환형": "정수",
  "몸": [
    ["선언", "lo", "정수", ["수", 0]],
    ["선언", "hi", "정수", ["빼기", ["길이", ["이름", "a"]], ["수", 1]]],
    ["반복", ["<=", ["이름", "lo"], ["이름", "hi"]], [
      ["선언", "mid", "정수", ["몫", ["더하기", ["이름", "lo"], ["이름", "hi"]], ["수", 2]]],
      ["분기", ["==", ["색인", ["이름", "a"], ["이름", "mid"]], ["이름", "target"]],
        [["반환", ["이름", "mid"]]], []],
      ["분기", ["<", ["색인", ["이름", "a"], ["이름", "mid"]], ["이름", "target"]],
        [["대입", "lo", ["더하기", ["이름", "mid"], ["수", 1]]]],
        [["대입", "hi", ["빼기", ["이름", "mid"], ["수", 1]]]]]
    ]],
    ["반환", ["수", -1]]
  ],
  "시험": [
    {"인자": [[1, 3, 5, 7, 9, 11], 7], "기대": 3},
    {"인자": [[1, 3, 5, 7, 9, 11], 1], "기대": 0},
    {"인자": [[1, 3, 5, 7, 9, 11], 4], "기대": -1}
  ]
}
