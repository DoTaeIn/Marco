          ["색인대입", ["이름", "a"], ["더하기", ["이름", "j"], ["수", 1]],
            ["이름", "t"]]
        ], []],
        ["대입", "j", ["더하기", ["이름", "j"], ["수", 1]]]
      ]],
      ["대입", "i", ["더하기", ["이름", "i"], ["수", 1]]]
    ]],
    ["반환", ["이름", "a"]]
  ],
  "시험": [
